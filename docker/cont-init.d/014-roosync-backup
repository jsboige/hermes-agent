#!/command/with-contenv sh
# shellcheck shell=sh
# Auto-backup critical files on every boot, AFTER the restore script has run
# (renumbered 012 -> 014: at 012, .env does not exist yet — 013 creates it).
# Stores in /opt/data/backups/auto-YYYYMMDD-HHmmss.tar.gz, max 3 rotated.
#
# 2026-10-23 fix: the old shim ran TWO tars into the SAME file; the second
# one listed po-2026-era paths (.hermes/state.db...) that do not exist on the
# ai-01 layout (files are direct children of /opt/data), so every archive
# since 14/10 was a 155-byte EMPTY shell, with errors swallowed by || true.
# Measured: auto-20261019/21/23 all 154-155 bytes. One tar, real paths, and
# an EMPTY-archive check that FAILS LOUDLY instead of a false comfort.
set -e

DATA="/opt/data"
BACKUP_DIR="$DATA/backups"
MAX_BACKUPS=3

mkdir -p "$BACKUP_DIR" 2>/dev/null || true
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_FILE="$BACKUP_DIR/auto-$TIMESTAMP.tar.gz"

# Single tar, real ai-01 layout; missing optional files skipped without
# killing the boot. state.db/sessions are EXCLUDED on purpose: restore never
# touches them and they are ~226MB gz — the GDrive weekly backup owns them
# (hermes-backup-essentials.ps1 -Weekly).
tar -czf "$BACKUP_FILE" \
    -C "$DATA" \
    config.yaml SOUL.md cron/jobs.json \
    .env .env.secrets \
    skills memories \
    kanban.db kanban.db-wal kanban.db-shm \
    2>/dev/null || true

# Empty-archive guard: a tar.gz under 1KB captured nothing.
SIZE_BYTES=$(wc -c < "$BACKUP_FILE" 2>/dev/null || echo 0)
if [ "$SIZE_BYTES" -lt 1000 ]; then
    echo "[roosync-backup] WARNING: auto backup $BACKUP_FILE is ${SIZE_BYTES} bytes — EMPTY, boot-time backup failed (check file list above)"
else
    echo "[roosync-backup] Auto backup: $BACKUP_FILE ($SIZE_BYTES bytes)"
fi

# Rotation — keep last N auto backups
COUNT=$(ls -1 "$BACKUP_DIR"/auto-*.tar.gz 2>/dev/null | wc -l)
if [ "$COUNT" -gt "$MAX_BACKUPS" ]; then
    ls -1t "$BACKUP_DIR"/auto-*.tar.gz | tail -n +$((MAX_BACKUPS + 1)) | xargs rm -f 2>/dev/null || true
fi
