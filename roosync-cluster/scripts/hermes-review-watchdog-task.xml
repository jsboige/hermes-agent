<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\Hermes-Review-Watchdog</URI>
    <Description>Detecte un pr-review Hermes qui tourne sans poster. Le cron peut finir status=ok sans aucune review (panne modele/provider, derive gh-auth, tempete de rate-limit) : le signal metier est la review postee, pas le statut du cron. Interroge l'API GitHub directement avec le token du volume hote, donc fonctionne meme conteneur arrete : PRs ouvertes des depots cibles et derniere review du bot (login resolu depuis le token) portant le marqueur [Hermes. Alerte Telegram si aucune depuis 4h ; seule une alerte LIVREE arme le cooldown de 4h. Toutes les 30 min a :07/:37 (off-minutes, distincts des :11/:41 du watchdog cron-output).</Description>
    <Author>Hermes Agent workspace</Author>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <!-- TEMPLATE, not a registerable file as-is. Task Scheduler rejects an empty
           UserId, so no SID is versioned here either: this repo is a public fork and
           the user SID is an identifier. Deploy with register-host-watchdog.ps1,
           which resolves the current user's SID at run time and substitutes this token
           (it also runs a dry run unless given -Apply). -->
      <UserId>__USER_SID__</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <RestartOnFailure>
      <Count>2</Count>
      <Interval>PT5M</Interval>
    </RestartOnFailure>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <TimeTrigger>
      <StartBoundary>2026-10-09T09:07:00+02:00</StartBoundary>
      <Repetition>
        <Interval>PT30M</Interval>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>wscript.exe</Command>
      <Arguments>//B //Nologo "C:\ProgramData\claude-hidden-launchers\Hermes-Review-Watchdog.vbs"</Arguments>
    </Exec>
  </Actions>
</Task>
